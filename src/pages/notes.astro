---
import Monogram from '../components/Monogram.astro';
import SectionBreak from '../components/SectionBreak.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Notes — Oliver Zhang"
  description="A small notebook of reading, research, and systems observations from Oliver Zhang."
>
  <header class="page-intro section-pad">
    <p class="eyebrow">Notebook</p>
    <h1>A deliberately small shelf.</h1>
    <p>
      Things I’m reading, longer project write-ups, and ideas worth returning to.
      More will appear here as they earn their place.
    </p>
  </header>

  <SectionBreak label="on the shelf" />

  <section class="notes-grid content-section" aria-label="Notebook entries">
    <article class="reading-card">
      <div class="book-spine" aria-hidden="true"><span>DDIA</span></div>
      <div>
        <p class="card-kicker">Currently reading</p>
        <h2>Designing Data-Intensive Applications</h2>
        <p class="byline">Martin Kleppmann</p>
        <p>
          A tour through the trade-offs behind reliable, scalable, and maintainable
          data systems—the sort of decisions that look simple only after someone
          has explained them well.
        </p>
      </div>
    </article>

    <article class="note-entry">
      <div class="note-icon"><Monogram /></div>
      <div>
        <p class="card-kicker">Research report · 2026</p>
        <h2>The retry tax</h2>
        <p>
          My PostgreSQL study asks what happens when transaction retries are bounded
          instead of hidden behind “retry until commit” assumptions.
        </p>
        <a class="text-link" href="https://github.com/ZhangO999/retry-tax-bench/blob/main/report/RetryTaxBench.pdf">
          Read the report <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  </section>
</BaseLayout>
