---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/oliver-cat.png';
import SectionBreak from '../components/SectionBreak.astro';
import ProjectRow from '../components/ProjectRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero section-pad">
    <div class="hero-copy">
      <p class="eyebrow">Oliver Zhang / University of Sydney</p>
      <h1>Hi, I’m Oliver.</h1>
      <p class="hero-lede">
        I’m a software engineering student interested in systems, databases,
        developer tools, and the small decisions that make software easier to
        understand.
      </p>
      <ul class="hero-links" aria-label="Key links">
        <li><a href="/work/">projects</a></li>
        <li><a href="/notes/">notes</a></li>
        <li><a href="https://github.com/ZhangO999">github</a></li>
        <li><a href="mailto:ozha8307@uni.sydney.edu.au">email</a></li>
      </ul>
    </div>

    <div class="portrait-stage" aria-label="Oliver's illustrated cat avatar">
      <Image
        class="portrait"
        src={avatar}
        alt="A white and grey cat in a black top hat and red bow tie, framed by white flowers"
        widths={[220, 320, 460]}
        sizes="(max-width: 700px) 220px, 300px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <SectionBreak label="projects" />

  <section class="content-section" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research, systems, and small experiments</p>
        <h2 id="selected-work">Selected projects</h2>
      </div>
      <a class="text-link" href="/work/">All projects <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-list">
      {projects.map(({ data }) => <ProjectRow {...data} />)}
    </div>
  </section>
</BaseLayout>
