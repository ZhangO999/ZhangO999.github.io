---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/oliver-cat.png';
import BowMark from '../components/BowMark.astro';
import PetalDivider from '../components/PetalDivider.astro';
import ProjectRow from '../components/ProjectRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero section-pad">
    <div class="hero-copy">
      <p class="eyebrow">Hello, internet.</p>
      <h1>I’m Oliver.</h1>
      <p class="hero-lede">
        I’m a software engineer in training at the University of Sydney. I like
        systems, useful tools, and making complicated things feel considered.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/work/">See my work <span aria-hidden="true">→</span></a>
        <a class="button button-quiet" href="mailto:ozha8307@uni.sydney.edu.au">Say hello</a>
      </div>
    </div>

    <div class="portrait-stage" aria-label="Oliver's illustrated cat avatar">
      <div class="portrait-flower flower-one" aria-hidden="true"></div>
      <div class="portrait-flower flower-two" aria-hidden="true"></div>
      <Image
        class="portrait"
        src={avatar}
        alt="A white and grey cat in a black top hat and red bow tie, framed by white flowers"
        widths={[220, 320, 460]}
        sizes="(max-width: 700px) 220px, 300px"
        loading="eager"
        fetchpriority="high"
      />
      <div class="portrait-caption">
        <BowMark size={22} />
        <span>formal on the internet</span>
      </div>
    </div>
  </section>

  <aside class="status-strip" aria-label="Current status">
    <span class="status-dot" aria-hidden="true"></span>
    <p>Based in Sydney · currently reading <em>Designing Data-Intensive Applications</em></p>
  </aside>

  <PetalDivider />

  <section class="content-section" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A few things I’ve made</p>
        <h2 id="selected-work">Selected work</h2>
      </div>
      <a class="text-link" href="/work/">All projects <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-list">
      {projects.map(({ data }) => <ProjectRow {...data} />)}
    </div>
  </section>

  <section class="two-up section-gap" aria-label="More about Oliver">
    <article class="paper-card">
      <p class="card-kicker">Off the clock</p>
      <h2>A small life outside the terminal.</h2>
      <p>
        I’m usually reading, tinkering with a half-finished idea, or finding a
        reason to turn a small curiosity into a project.
      </p>
      <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
    </article>

    <article class="paper-card paper-card-moss">
      <p class="card-kicker">The notebook</p>
      <h2>What I’m learning along the way.</h2>
      <p>
        Reading notes, systems observations, and occasional write-ups live on a
        deliberately small shelf.
      </p>
      <a class="text-link" href="/notes/">Open the notebook <span aria-hidden="true">→</span></a>
    </article>
  </section>

  <section class="contact-block section-gap" aria-labelledby="contact-title">
    <BowMark size={40} />
    <div>
      <p class="eyebrow">One last thing</p>
      <h2 id="contact-title">Have an interesting problem?</h2>
      <p>I’m always happy to compare notes, talk software, or hear about a project.</p>
    </div>
    <a class="button button-primary" href="mailto:ozha8307@uni.sydney.edu.au">Email me <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
