---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portrait from '../assets/oliver-portrait.jpg';
import badmintonMedal from '../assets/badminton-medal.jpg';
import badmintonPlaying from '../assets/badminton-playing.jpg';
import corgiSketch from '../assets/corgi-sketch.jpg';
import tekapo from '../assets/tekapo.jpg';
import SectionBreak from '../components/SectionBreak.astro';
import ProjectRow from '../components/ProjectRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero section-pad section-anchor" id="about">
    <div class="hero-copy">
      <h1>Oliver Zhang</h1>
      <p class="hero-lede">
        Computer science and maths at the University of Sydney. I like systems,
        databases, and problems where “correct” has an actual definition.
      </p>
      <p class="hero-now">
        Currently a research assistant in USYD’s Database Research Group, measuring
        what bounded retries cost across PostgreSQL isolation levels. Before that,
        machine-checked proofs for the seL4 microkernel at UNSW Trustworthy Systems.
      </p>
      <ul class="hero-links" aria-label="Key links">
        <li><a href="#projects">projects</a></li>
        <li><a href="https://github.com/ZhangO999">github</a></li>
        <li><a href="https://www.linkedin.com/in/oliver-zhang3">linkedin</a></li>
        <li><a href="mailto:ozha8307@uni.sydney.edu.au">email</a></li>
      </ul>
    </div>

    <div class="portrait-stage">
      <Image
        class="portrait"
        src={portrait}
        alt="Oliver Zhang"
        widths={[300, 460, 620]}
        sizes="(max-width: 700px) 210px, 280px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="home-divider"><SectionBreak label="projects" /></div>

  <section class="content-section section-anchor" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research, systems, and small experiments</p>
        <h2 id="projects-heading">Projects</h2>
      </div>
    </div>

    <div class="project-list">
      {projects.map(({ data }) => <ProjectRow {...data} />)}
    </div>
  </section>

  <div class="home-divider"><SectionBreak label="misc" /></div>

  <section class="content-section section-anchor" id="misc" aria-labelledby="misc-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Off the clock</p>
        <h2 id="misc-heading">Misc</h2>
      </div>
    </div>

    <ul class="misc-grid">
      <li class="misc-card">
        <p class="misc-title">MBTI</p>
        <p class="misc-caption">INTJ, apparently.</p>
      </li>

      <li class="misc-card">
        <p class="misc-title">Badminton</p>
        <div class="misc-shots">
          <Image
            src={badmintonPlaying}
            alt="Oliver mid-jump playing a smash on a badminton court"
            widths={[208, 416]}
            sizes="70px"
            loading="lazy"
          />
          <Image
            src={badmintonMedal}
            alt="Oliver wearing a medal after a badminton tournament"
            widths={[183, 366]}
            sizes="66px"
            loading="lazy"
          />
        </div>
        <p class="misc-caption">On and off for ~10 years.</p>
      </li>

      <li class="misc-card">
        <p class="misc-title">Best travel photo</p>
        <div class="misc-shots">
          <Image
            src={tekapo}
            alt="The Church of the Good Shepherd beside Lake Tekapo at sunset"
            widths={[240, 480, 720]}
            sizes="180px"
            loading="lazy"
          />
        </div>
        <p class="misc-caption">Church of the Good Shepherd, Lake Tekapo.</p>
      </li>

      <li class="misc-card">
        <p class="misc-title">Drawing</p>
        <div class="misc-shots">
          <Image
            src={corgiSketch}
            alt="Graphite sketch of a corgi's head"
            widths={[170, 340, 512]}
            sizes="70px"
            loading="lazy"
          />
        </div>
        <p class="misc-caption">Graphite, mostly animals. Should do it more.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
