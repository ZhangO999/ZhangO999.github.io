---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <button class="footer-scene" type="button" aria-label="Replay the footer cat's seg-fault">
    <picture class="footer-picture">
      <source
        media="(max-width: 600px)"
        srcset="/footer-cat-lab-mobile.webp"
        width="800"
        height="415"
      />
      <img
        class="footer-art"
        src="/footer-cat-lab.webp"
        alt=""
        width="1600"
        height="469"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <span class="segfault-label" aria-hidden="true">SEG-FAULT</span>
  </button>
  <div class="footer-meta">
    <p>© {year} Oliver Zhang</p>
    <div class="footer-links" aria-label="Social links">
      <a href="mailto:ozha8307@uni.sydney.edu.au">Email</a>
      <a href="https://github.com/ZhangO999">GitHub</a>
      <a href="https://github.com/ZhangO999/ZhangO999.github.io">Source</a>
    </div>
  </div>
</footer>

<script>
  const scene = document.querySelector<HTMLButtonElement>('.footer-scene');
  let faultTimer: number | undefined;

  scene?.addEventListener('click', () => {
    window.clearTimeout(faultTimer);
    scene.classList.remove('is-faulting');
    void scene.offsetWidth;
    scene.classList.add('is-faulting');

    faultTimer = window.setTimeout(() => {
      scene.classList.remove('is-faulting');
    }, 900);
  });
</script>
