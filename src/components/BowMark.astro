---
interface Props {
  size?: number;
  label?: string;
}

const { size = 30, label } = Astro.props;
---

<svg
  class="bow-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path d="M28 25c-6-6-16-8-19-4-3 5 1 17 8 20 4 2 8-1 12-5l-1-11Zm8 0c6-6 16-8 19-4 3 5-1 17-8 20-4 2-8-1-12-5l1-11Z" />
  <rect x="26" y="24" width="12" height="14" rx="4" />
</svg>

<style>
  .bow-mark {
    display: block;
    overflow: visible;
  }

  path {
    fill: var(--bow);
    stroke: var(--ink);
    stroke-linejoin: round;
    stroke-width: 3;
  }

  rect {
    fill: var(--bow-light);
    stroke: var(--ink);
    stroke-width: 3;
  }
</style>
