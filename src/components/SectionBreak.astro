---
interface Props {
  label?: string;
}

const { label = 'next' } = Astro.props;
---

<div class="section-break" aria-hidden="true">
  <span>{label}</span>
  <i></i>
</div>

<style>
  .section-break {
    align-items: center;
    color: var(--ink-muted);
    display: flex;
    font-family: var(--mono);
    font-size: 0.63rem;
    gap: 0.8rem;
    letter-spacing: 0.12em;
    margin: var(--space-8) 0;
    text-transform: uppercase;
  }

  i {
    background: var(--line);
    display: block;
    height: 1px;
    width: 4.5rem;
  }
</style>
