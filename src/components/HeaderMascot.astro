<button class="header-mascot" type="button" aria-label="Poke the cat">
  <img src="/avatar.webp" alt="" width="44" height="44" />
</button>

<script>
  const mascot = document.querySelector<HTMLButtonElement>('.header-mascot');
  const label = document.querySelector<HTMLElement>('.brand-label');
  let resetTimer: number | undefined;

  mascot?.addEventListener('click', () => {
    window.clearTimeout(resetTimer);
    mascot.classList.remove('is-bopping');
    label?.classList.remove('is-bopped');
    void mascot.offsetWidth;
    mascot.classList.add('is-bopping');
    label?.classList.add('is-bopped');

    resetTimer = window.setTimeout(() => {
      mascot.classList.remove('is-bopping');
      label?.classList.remove('is-bopped');
    }, 520);
  });
</script>

<style>
  .header-mascot {
    background: transparent;
    border: 0;
    cursor: pointer;
    height: 2.55rem;
    margin: -0.25rem 0;
    padding: 0;
    position: relative;
    width: 2.55rem;
  }

  img {
    border: 1px solid var(--ink);
    border-radius: 50%;
    height: 2.45rem;
    left: 50%;
    object-fit: contain;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    transform-origin: 50% 60%;
    width: auto;
  }

  .header-mascot:hover img {
    transform: translate(-50%, -50%) rotate(-2deg);
  }

  .header-mascot.is-bopping img {
    animation: cat-nudge 420ms ease-out both;
  }

  @keyframes cat-nudge {
    0%, 100% { transform: translate(-50%, -50%) rotate(0); }
    45% { transform: translate(-50%, -54%) rotate(-7deg); }
    70% { transform: translate(-50%, -50%) rotate(2deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-mascot.is-bopping img {
      animation: none;
    }
  }
</style>
